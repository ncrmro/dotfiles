#!/usr/bin/env python3
"""Generate portable OBS imports; never modify the running OBS configuration."""

import argparse
import json
import os
from pathlib import Path
import shutil
import sys
import uuid


def source(name, kind, settings=None, versioned_id=None):
    return {
        "name": name,
        "uuid": str(uuid.uuid5(uuid.NAMESPACE_URL, "obs-template/" + name)),
        "id": kind,
        "versioned_id": versioned_id or kind,
        "settings": settings or {},
        "enabled": True,
        "volume": 1.0,
        "balance": 0.5,
        "mixers": 255,
        "muted": False,
        "hotkeys": {},
        "private_settings": {},
    }


def item(src, number, x, y, width, height, fill=False):
    return {
        "name": src["name"], "source_uuid": src["uuid"], "id": number,
        "visible": True, "locked": True, "rot": 0.0, "align": 5,
        "pos": {"x": x, "y": y}, "scale": {"x": 1.0, "y": 1.0},
        "bounds": {"x": width, "y": height},
        "bounds_type": 3 if fill else 2, "bounds_align": 0,
        "bounds_crop": fill,
        "crop_left": 0, "crop_right": 0, "crop_top": 0, "crop_bottom": 0,
        "scale_filter": "bicubic", "blend_method": "default",
        "blend_type": "normal", "private_settings": {},
    }


def scene(name, width, height, items):
    return source(name, "scene", {
        "custom_size": True, "cx": width, "cy": height,
        "id_counter": len(items), "items": items,
    })


def generate(config_dir, output, platform, camera_device, desk_camera_device=None):
    layout = json.loads((config_dir / "layout.json").read_text())
    w, h, size, margin, fps = (layout[k] for k in
                              ("width", "height", "webcam_size", "margin", "fps"))
    if any(type(v) is not int or v <= 0 for v in (w, h, size, fps)):
        raise ValueError("Dimensions and fps must be positive integers")
    if w * 9 != h * 16:
        raise ValueError("Canvas must have a 16:9 aspect ratio")
    if type(margin) is not int or margin < 0 or size + 2 * margin > min(w, h):
        raise ValueError("Webcam and margins must fit within the canvas")
    name = layout["name"]
    blur = layout.get("background_blur", 0)
    if type(blur) is not int or not 0 <= blur <= 20:
        raise ValueError("background_blur must be an integer from 0 to 20")
    desk_enabled = layout.get("desk_camera", False)
    if type(desk_enabled) is not bool:
        raise ValueError("desk_camera must be true or false")
    if not isinstance(name, str) or not name.strip() or "\n" in name or "\r" in name:
        raise ValueError("Name must be a nonempty single line")
    # Refuse to replace an existing generated export, including its device choices.
    output.mkdir(parents=True, exist_ok=False)
    assets = output / "assets"
    assets.mkdir()
    mask = assets / "circle-mask.png"
    shutil.copyfile(config_dir / "circle-mask.png", mask)
    if platform == "macos":
        desktop = source("Desktop", "screen_capture", {"hide_obs": True})
        camera = source("Camera", "macos-avcapture",
                        {"enable_audio": False, **({"device": camera_device} if camera_device else {})})
        mic = source("Microphone", "coreaudio_input_capture", {"device_id": "default"})
    else:
        desktop = source("Desktop", "pipewire-screen-capture-source")
        camera = source("Camera", "v4l2_input",
                        {"device_id": camera_device} if camera_device else {})
        mic = source("Microphone", "pulse_input_capture", {"device_id": "default"})
    if blur:
        camera["filters"] = [source("Background Blur", "background_removal", {
            "blur_background": blur,
            "model_select": "models/selfie_segmentation.with_runtime_opt.ort",
            "useGPU": "coreml" if platform == "macos" else "cpu",
            "numThreads": 2,
            "feather": 0.1,
            "enable_focal_blur": False,
        })]
    # Normalize any camera aspect ratio to a square before applying the round mask.
    webcam = scene("Webcam Circle", size, size,
                   [item(camera, 1, 0, 0, size, size, fill=True)])
    webcam["filters"] = [source("Circle Mask", "mask_filter", {
        "image_path": str(mask), "type": "mask_alpha_filter.effect",
        "opacity": 1.0, "color": 16777215, "stretch": False,
    }, versioned_id="mask_filter_v2")]
    intro = scene("Intro — Face", w, h, [item(camera, 1, 0, 0, w, h)])
    if blur and platform == "macos":
        # A neutral SDR processing pass fixes the background-removal plugin's
        # overexposed fullscreen output on the verified Mac OBS configuration.
        intro["filters"] = [source("Color Processing", "color_filter",
                                   versioned_id="color_filter_v2")]
    views = [intro]
    for label, fill in (("Desktop — Fit", False), ("Desktop — Fill", True)):
        views.append(scene(label, w, h, [
            item(desktop, 1, 0, 0, w, h, fill=fill),
            item(webcam, 2, w - size - margin, h - size - margin, size, size),
        ]))
    extra_sources = []
    if desk_enabled:
        if platform == "macos":
            desk = source("Desk Cam", "macos-avcapture", {
                "enable_audio": False,
                **({"device": desk_camera_device} if desk_camera_device else {}),
            })
        else:
            desk = source("Desk Cam", "v4l2_input",
                          {"device_id": desk_camera_device} if desk_camera_device else {})
        extra_sources.append(desk)
        views.append(scene("Desk Cam — Fullscreen", w, h,
                           [item(desk, 1, 0, 0, w, h),
                            item(webcam, 2, w - size - margin, h - size - margin, size, size)]))
    collection = {
        "name": name, "version": 1,
        "sources": [desktop, camera, webcam] + extra_sources + views,
        "AuxAudioDevice1": mic,
        "groups": [], "transitions": [], "quick_transitions": [],
        "scene_order": [{"name": v["name"]} for v in views] + [{"name": webcam["name"]}],
        "current_scene": "Desktop — Fit", "current_program_scene": "Desktop — Fit",
        "current_transition": "Fade", "transition_duration": 300,
    }
    (output / "scene-collection.json").write_text(json.dumps(collection, indent=2) + "\n")
    profile = output / "profile"
    profile.mkdir()
    # A conservative software encoder is available on both OSes; hardware encoders
    # and recording paths remain local choices after import. No service/key export.
    (profile / "basic.ini").write_text(
        f"[General]\nName={name}\n\n"
        f"[Video]\nBaseCX={w}\nBaseCY={h}\nOutputCX={w}\nOutputCY={h}\n"
        f"FPSType=0\nFPSCommon={fps}\nScaleType=bicubic\n"
        "ColorFormat=NV12\nColorSpace=709\nColorRange=Partial\n\n"
        "[Output]\nMode=Simple\n\n"
        "[SimpleOutput]\nStreamEncoder=x264\nRecEncoder=x264\n"
        "RecQuality=HQ\nRecFormat2=mkv\nVBitrate=6000\nABitrate=160\n\n"
        "[Audio]\nSampleRate=48000\nChannelSetup=Stereo\n"
    )
    print(f"Import Scene Collection → Import: {output / 'scene-collection.json'}")
    print(f"Import Profile → Import: {profile}")
    print("Select the imported profile and collection, then choose Desktop and Camera devices.")
    if desk_enabled:
        print("Choose the second camera in the Desk Cam source's Properties.")
    print("Keep this export directory in place: OBS references its circle-mask asset.")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    default_config = Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config"))) / "obs-template"
    parser.add_argument("--config-dir", type=Path, default=default_config)
    parser.add_argument("--platform", choices=("macos", "linux"),
                        default="macos" if sys.platform == "darwin" else "linux")
    parser.add_argument("--camera-device", help="Optional V4L2 device path or macOS camera ID")
    parser.add_argument("--desk-camera-device", help="Optional device path or ID for the second camera")
    parser.add_argument("--output", required=True, type=Path, help="New directory for import files")
    args = parser.parse_args()
    try:
        generate(args.config_dir.expanduser().resolve(), args.output.expanduser().resolve(),
                 args.platform, args.camera_device, args.desk_camera_device)
    except (OSError, ValueError, KeyError) as error:
        parser.exit(1, f"obs-template: {error}\n")


if __name__ == "__main__":
    main()
