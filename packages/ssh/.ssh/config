# Ported from ks-config Home Manager. Edit directly; Stow links this file.

Host *
	AddKeysToAgent no
	Compression no
	ControlMaster no
	ControlPath ~/.ssh/master-%r@%n:%p
	ControlPersist no
	ForwardAgent no
	HashKnownHosts no
	ServerAliveCountMax 3
	ServerAliveInterval 0
	UserKnownHostsFile ~/.ssh/known_hosts

Host unsup-laptop.local
	User nicholas
	SetEnv TERM=xterm-256color

Host unsup-air.local
	SetEnv TERM=xterm-256color

Host unsup-16-pro.local
	User nicholas
	SetEnv TERM=xterm-256color

Host ncrmro-laptop-14
	SetEnv TERM=xterm-256color
