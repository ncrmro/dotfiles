background-opacity = 0.950000
config-file = /home/ncrmro/.config/themes/current/ghostty.conf
confirm-close-surface = false
cursor-style = block
cursor-style-blink = false
font-family = JetBrainsMono Nerd Font
font-size = 12
font-style = Regular
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
keybind = ctrl+shift+w=previous_tab
keybind = ctrl+shift+e=new_tab
keybind = ctrl+shift+r=next_tab
keybind = ctrl+shift+c=close_surface
keybind = ctrl+page_up=unbind
keybind = ctrl+page_down=unbind
keybind = ctrl+tab=unbind
keybind = ctrl+shift+o=unbind
keybind = ctrl+alt+up=unbind
keybind = ctrl+alt+down=unbind
keybind = ctrl+alt+left=unbind
keybind = ctrl+alt+right=unbind
mouse-scroll-multiplier = 0.950000
resize-overlay = never
window-decoration = none
window-padding-x = 14
window-padding-y = 14
